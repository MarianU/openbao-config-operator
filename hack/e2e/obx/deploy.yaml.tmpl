apiVersion: apps/v1
kind: Deployment
metadata:
  name: mto-openbao-extension
  namespace: mto-system
spec:
  replicas: 1
  selector:
    matchLabels: { app: mto-openbao-extension }
  template:
    metadata:
      labels: { app: mto-openbao-extension }
    spec:
      serviceAccountName: mto-openbao-extension
      containers:
        - name: manager
          image: ${OPERATOR_IMAGE}
          imagePullPolicy: IfNotPresent
          env:
            - name: VAULT_ADDR
              value: http://openbao.openbao.svc.cluster.local:8200
            - name: VAULT_TOKEN
              valueFrom:
                secretKeyRef:
                  name: mto-openbao-token
                  key: token
